  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Credencial própria do serviço com escopos resolvidos no backend. x-agent-actor não autoriza."
      },
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gab_sessao",
        "description": "Sessão humana já existente no Gabinete."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "state",
          "correlationId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
